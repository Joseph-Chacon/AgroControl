# Copia estos valores a apps/api/.env y reemplaza las credenciales.
# API
PORT=3000
FRONTEND_URL=http://localhost:4200
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# PostgreSQL
POSTGRES_DB=agrocontrol
POSTGRES_USER=agrocontrol
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://agrocontrol:change-this-password@localhost:5432/agrocontrol?schema=public
