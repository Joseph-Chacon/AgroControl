generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BaseUnit {
  ML
  G
  UND
}

enum MovementType {
  PURCHASE
  APPLICATION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFORMATION_IN
  TRANSFORMATION_OUT
}

enum HarvestGrade {
  FIRST
  SECOND
  THIRD
  BOLITA
  RAYADO
  ECHADO
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  reason     String?
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Sequence {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  prefix    String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("sequences")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  baseUnit  BaseUnit
  createdAt DateTime @default(now())

  @@map("units")
}

model Product {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique
  name        String
  baseUnit    BaseUnit
  minStock    Decimal            @default(0) @db.Decimal(18, 4)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  inventory   InventoryItem?
  movements   InventoryMovement[]
  purchaseItems PurchaseItem[]
  applicationItems ApplicationItem[]
  transformationOutputs InventoryTransformation[] @relation("TransformationOutput")
  transformationItems InventoryTransformationItem[]

  @@map("products")
}

model Farm {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  isActive Boolean @default(true)
  lots Lot[]
  @@map("farms")
}
model Lot {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  isActive Boolean @default(true)
  farmId String @db.Uuid
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Restrict)
  crops Crop[]
  applications Application[]
  @@map("lots")
}

model Harvest {
  id String @id @default(uuid()) @db.Uuid
  cropId String @db.Uuid
  harvestedAt DateTime @default(now())
  quantity Decimal @db.Decimal(18, 4)
  unit String @default("KG")
  isVoided Boolean @default(false)
  voidedAt DateTime?
  voidReason String?
  crop Crop @relation(fields: [cropId], references: [id], onDelete: Restrict)
  items HarvestItem[]
  @@map("harvests")
}
model HarvestItem {
  id String @id @default(uuid()) @db.Uuid
  harvestId String @db.Uuid
  grade HarvestGrade
  boxes Int
  unitPrice Decimal? @db.Decimal(18, 2)
  total Decimal? @db.Decimal(18, 2)
  harvest Harvest @relation(fields: [harvestId], references: [id], onDelete: Cascade)
  @@unique([harvestId, grade])
  @@map("harvest_items")
}
model Customer {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  isActive Boolean @default(true)
  sales Sale[]
  @@map("customers")
}
model TransportTrip {
  id String @id @default(uuid()) @db.Uuid
  cropId String @db.Uuid
  tripDate DateTime @default(now())
  amount Decimal @db.Decimal(18, 2)
  notes String?
  isVoided Boolean @default(false)
  voidedAt DateTime?
  voidReason String?
  crop Crop @relation(fields: [cropId], references: [id], onDelete: Restrict)
  @@map("transport_trips")
}
model Sale {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  cropId String? @db.Uuid
  customerId String? @db.Uuid
  soldAt DateTime @default(now())
  total Decimal @db.Decimal(18, 2)
  isVoided Boolean @default(false)
  voidedAt DateTime?
  voidReason String?
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  @@map("sales")
}
model Expense {
  id String @id @default(uuid()) @db.Uuid
  cropId String? @db.Uuid
  description String
  occurredAt DateTime @default(now())
  amount Decimal @db.Decimal(18, 2)
  isVoided Boolean @default(false)
  voidedAt DateTime?
  voidReason String?
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: Restrict)
  @@map("expenses")
}
model Crop {
  id String @id @default(uuid()) @db.Uuid
  name String
  lotId String @db.Uuid
  isActive Boolean @default(true)
  plantedAt DateTime @default(now())
  plantedPlants Int @default(0)
  removedAt DateTime?
  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  applications Application[]
  harvests Harvest[]
  expenses Expense[]
  sales Sale[]
  transportTrips TransportTrip[]
  @@map("crops")
}
model Application {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  lotId String @db.Uuid
  cropId String? @db.Uuid
  appliedAt DateTime @default(now())
  notes String?
  totalCost Decimal @db.Decimal(18, 2)
  isVoided Boolean @default(false)
  voidedAt DateTime?
  voidReason String?
  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: Restrict)
  items ApplicationItem[]
  @@map("applications")
}
model ApplicationItem {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  productId String @db.Uuid
  quantity Decimal @db.Decimal(18, 4)
  averageCost Decimal @db.Decimal(18, 6)
  totalCost Decimal @db.Decimal(18, 2)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@map("application_items")
}

model Purchase {
  id           String         @id @default(uuid()) @db.Uuid
  code         String         @unique
  supplierName String?
  supplierId   String?        @db.Uuid
  receivedAt   DateTime       @default(now())
  total        Decimal        @db.Decimal(18, 2)
  createdAt    DateTime       @default(now())
  isVoided     Boolean        @default(false)
  voidedAt     DateTime?
  voidReason   String?
  items        PurchaseItem[]
  supplier     Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@map("purchases")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  phone     String?
  email     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  purchases Purchase[]
  @@map("suppliers")
}

model PurchaseItem {
  id          String   @id @default(uuid()) @db.Uuid
  purchaseId  String   @db.Uuid
  productId   String   @db.Uuid
  quantity    Decimal  @db.Decimal(18, 4)
  totalCost   Decimal  @db.Decimal(18, 2)
  unitCost    Decimal  @db.Decimal(18, 6)
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("purchase_items")
}

model InventoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @unique @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  averageCost Decimal  @default(0) @db.Decimal(18, 6)
  lastCost    Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory_items")
}

model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @db.Uuid
  type           MovementType
  quantity       Decimal      @db.Decimal(18, 4)
  quantityBefore Decimal      @db.Decimal(18, 4)
  quantityAfter  Decimal      @db.Decimal(18, 4)
  unitCost       Decimal      @db.Decimal(18, 6)
  referenceType  String
  referenceId    String       @db.Uuid
  notes          String?
  occurredAt     DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model InventoryTransformation {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  outputProductId String   @db.Uuid
  outputQuantity  Decimal  @db.Decimal(18, 4)
  totalCost       Decimal  @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime @default(now())
  isVoided        Boolean  @default(false)
  voidedAt        DateTime?
  voidReason      String?
  outputProduct   Product  @relation("TransformationOutput", fields: [outputProductId], references: [id], onDelete: Restrict)
  items           InventoryTransformationItem[]

  @@map("inventory_transformations")
}

model InventoryTransformationItem {
  id               String                  @id @default(uuid()) @db.Uuid
  transformationId String                  @db.Uuid
  productId        String                  @db.Uuid
  quantity         Decimal                 @db.Decimal(18, 4)
  unitCost         Decimal                 @db.Decimal(18, 6)
  totalCost        Decimal                 @db.Decimal(18, 2)
  transformation   InventoryTransformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("inventory_transformation_items")
}
